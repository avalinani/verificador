# HTTPS reverse proxy for the PDF validator (Caddy obtains and renews the
# Let's Encrypt certificate by itself). Replace the hostname with your own.
# No ACME email is configured on purpose (Caddy works without one).
vps-651608c6.vps.ovh.net {
	encode zstd gzip

	header Strict-Transport-Security "max-age=31536000; includeSubDomains"

	# Uploads up to 81 MB reach the app; the app enforces its own 80 MB limit.
	request_body {
		max_size 82MB
	}

	reverse_proxy localhost:8963 {
		# Analyses of large PDFs can take several seconds.
		transport http {
			response_header_timeout 120s
		}
	}
}
