<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>com.coam</groupId>
  <artifactId>pdf-validator</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>pdf-validator</name>
  <description>PDF signature, timestamp, trust and PDF/A conformance auditor</description>

  <properties>
    <java.version>25</java.version>
    <pdfbox.version>3.0.8</pdfbox.version>
    <bouncycastle.version>1.86</bouncycastle.version>
    <springdoc.version>3.1.1</springdoc.version>
    <archunit.version>1.5.1</archunit.version>
    <!-- T18b: overrides of the versions managed by Spring Boot 4.1.1 (the latest
         release), which OSV.dev flags. Remove each one once Boot manages a
         patched version; PatchedDependenciesTest guards the minimums.
         tomcat.version: 11.0.24 -> 11.0.26 (CVE-2026-65905, CVE-2026-65182, CVE-2026-68525).
         jackson-bom.version (Jackson 3): 3.1.5 -> 3.1.7 (CVE-2026-68497, CVE-2026-83557, CVE-2026-19032).
         jackson-2-bom.version (Jackson 2, via springdoc/swagger-core): 2.21.5 -> 2.21.6. -->
    <tomcat.version>11.0.26</tomcat.version>
    <jackson-bom.version>3.1.7</jackson-bom.version>
    <jackson-2-bom.version>2.21.6</jackson-2-bom.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <dependency>
      <groupId>org.apache.pdfbox</groupId>
      <artifactId>pdfbox</artifactId>
      <version>${pdfbox.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.pdfbox</groupId>
      <artifactId>preflight</artifactId>
      <version>${pdfbox.version}</version>
    </dependency>

    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcprov-jdk18on</artifactId>
      <version>${bouncycastle.version}</version>
    </dependency>
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcpkix-jdk18on</artifactId>
      <version>${bouncycastle.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>${springdoc.version}</version>
    </dependency>

    <dependency>
      <!-- Boot 4's modular test starters mirror the matching feature starter:
           since we use spring-boot-starter-webmvc (not -web), the matching
           test starter is -webmvc-test, not the generic -test one. It already
           depends on spring-boot-starter-test transitively (confirmed against
           the resolved 4.1.1 BOM/POM), plus MockMvc autoconfiguration
           (spring-boot-webmvc-test) and a REST test client
           (spring-boot-resttestclient), both needed for T09's controller and
           end-to-end tests. -->
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>${archunit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <!-- Deterministic artifact name (target/pdf-validator.jar), used by the Dockerfile. -->
    <finalName>${project.artifactId}</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <!-- Adds target/classes/META-INF/build-info.properties (bound to
                 the default prepare-package phase), so BuildProperties is
                 available at runtime for the OpenAPI "version" field and
                 Actuator's /actuator/info endpoint. Additive: does not
                 replace the default "repackage" execution already bound by
                 spring-boot-starter-parent. -->
            <id>build-info</id>
            <goals>
              <goal>build-info</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>jacoco-prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>jacoco-report</id>
            <phase>verify</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
