<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>com.coam</groupId>
  <artifactId>pdf-validator</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>pdf-validator</name>
  <description>PDF signature, timestamp, trust and PDF/A conformance auditor</description>

  <properties>
    <java.version>25</java.version>
    <pdfbox.version>3.0.8</pdfbox.version>
    <bouncycastle.version>1.86</bouncycastle.version>
    <springdoc.version>3.1.1</springdoc.version>
    <archunit.version>1.5.1</archunit.version>
    <!-- T18b: overrides of the versions managed by Spring Boot 4.1.1 (the latest
         release), which OSV.dev flags. Remove each one once Boot manages a
         patched version; PatchedDependenciesTest guards the minimums.
         tomcat.version: 11.0.24 -> 11.0.26 (CVE-2026-65905, CVE-2026-65182, CVE-2026-68525).
         jackson-bom.version (Jackson 3): 3.1.5 -> 3.1.7 (CVE-2026-68497, CVE-2026-83557, CVE-2026-19032).
         jackson-2-bom.version (Jackson 2, via springdoc/swagger-core): 2.21.5 -> 2.21.6. -->
    <tomcat.version>11.0.26</tomcat.version>
    <jackson-bom.version>3.1.7</jackson-bom.version>
    <jackson-2-bom.version>2.21.6</jackson-2-bom.version>
    <jacoco.min.line>0.88</jacoco.min.line>
    <spotbugs.plugin.version>4.10.4.1</spotbugs.plugin.version>
    <spotbugs.version>4.10.4</spotbugs.version>
    <findsecbugs.version>1.14.0</findsecbugs.version>
    <pmd.plugin.version>3.28.0</pmd.plugin.version>
    <pmd.version>7.28.0</pmd.version>
    <pitest.plugin.version>1.30.0</pitest.plugin.version>
    <pitest.junit5.version>1.2.3</pitest.junit5.version>
    <jacoco.min.branch>0.75</jacoco.min.branch>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <dependency>
      <groupId>org.apache.pdfbox</groupId>
      <artifactId>pdfbox</artifactId>
      <version>${pdfbox.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.pdfbox</groupId>
      <artifactId>preflight</artifactId>
      <version>${pdfbox.version}</version>
    </dependency>

    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcprov-jdk18on</artifactId>
      <version>${bouncycastle.version}</version>
    </dependency>
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcpkix-jdk18on</artifactId>
      <version>${bouncycastle.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>${springdoc.version}</version>
    </dependency>

    <dependency>
      <!-- Boot 4's modular test starters mirror the matching feature starter:
           since we use spring-boot-starter-webmvc (not -web), the matching
           test starter is -webmvc-test, not the generic -test one. It already
           depends on spring-boot-starter-test transitively (confirmed against
           the resolved 4.1.1 BOM/POM), plus MockMvc autoconfiguration
           (spring-boot-webmvc-test) and a REST test client
           (spring-boot-resttestclient), both needed for T09's controller and
           end-to-end tests. -->
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>${archunit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <!-- Deterministic artifact name (target/pdf-validator.jar), used by the Dockerfile. -->
    <finalName>${project.artifactId}</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <!-- Adds target/classes/META-INF/build-info.properties (bound to
                 the default prepare-package phase), so BuildProperties is
                 available at runtime for the OpenAPI "version" field and
                 Actuator's /actuator/info endpoint. Additive: does not
                 replace the default "repackage" execution already bound by
                 spring-boot-starter-parent. -->
            <id>build-info</id>
            <goals>
              <goal>build-info</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>jacoco-prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>jacoco-report</id>
            <phase>verify</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
          <execution>
            <!-- Coverage ratchet: fails the build if bundle coverage drops below
                 the floor. Measured on 2026-09-30: line 89.99 %, branch 77.46 %;
                 the floors sit a little below. Raise them as coverage improves. -->
            <id>jacoco-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${jacoco.min.line}</minimum>
                    </limit>
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${jacoco.min.branch}</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <!-- Static analysis, a build gate: bug patterns plus the FindSecBugs security detectors,
             failing `verify` on any finding at or above the Medium threshold. Justified false
             positives live in config/spotbugs/exclude.xml, each with its reason. Reports:
             target/spotbugsXml.xml and target/spotbugs.html. -->
        <groupId>com.github.spotbugs</groupId>
        <artifactId>spotbugs-maven-plugin</artifactId>
        <version>${spotbugs.plugin.version}</version>
        <dependencies>
          <dependency>
            <groupId>com.github.spotbugs</groupId>
            <artifactId>spotbugs</artifactId>
            <version>${spotbugs.version}</version>
          </dependency>
        </dependencies>
        <configuration>
          <effort>Max</effort>
          <threshold>Medium</threshold>
          <failOnError>true</failOnError>
          <excludeFilterFile>config/spotbugs/exclude.xml</excludeFilterFile>
          <xmlOutput>true</xmlOutput>
          <plugins>
            <plugin>
              <groupId>com.h3xstream.findsecbugs</groupId>
              <artifactId>findsecbugs-plugin</artifactId>
              <version>${findsecbugs.version}</version>
            </plugin>
          </plugins>
        </configuration>
        <executions>
          <execution>
            <id>spotbugs-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <!-- PMD (bad practices, complexity, design) + CPD (copy/paste detection). PMD fails the
             build on priority 1-2 violations; priority 3 (mostly the complexity rules) stays
             reported only. CPD fails on any duplicate of 100+ tokens. Reports: target/pmd.xml,
             target/site/pmd.html, target/cpd.xml. PMD is pinned to a release that parses Java 25.
             Ruleset: config/pmd/ruleset.xml. -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-pmd-plugin</artifactId>
        <version>${pmd.plugin.version}</version>
        <dependencies>
          <dependency>
            <groupId>net.sourceforge.pmd</groupId>
            <artifactId>pmd-core</artifactId>
            <version>${pmd.version}</version>
          </dependency>
          <dependency>
            <groupId>net.sourceforge.pmd</groupId>
            <artifactId>pmd-java</artifactId>
            <version>${pmd.version}</version>
          </dependency>
        </dependencies>
        <configuration>
          <targetJdk>${java.version}</targetJdk>
          <rulesets>
            <ruleset>config/pmd/ruleset.xml</ruleset>
          </rulesets>
          <printFailingErrors>true</printFailingErrors>
          <failOnViolation>true</failOnViolation>
          <failurePriority>2</failurePriority>
          <minimumTokens>100</minimumTokens>
          <excludeFromFailureFile></excludeFromFailureFile>
        </configuration>
        <executions>
          <execution>
            <id>pmd-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
              <goal>cpd-check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <!-- T14 maintainer tool, never part of the runtime jar or the Docker image: its code lives
           under src/test/java/com/coam/pdfvalidator/tools/tsl/ (tested by the normal build) and
           runs on the test classpath. It downloads the EU LOTL and the Spanish TSL, verifies both
           XML signatures and regenerates src/main/resources/truststore/ (anchors, index.txt,
           SOURCES.md). Run: ./mvnw -q -Ptsl-sync -->
      <id>tsl-sync</id>
      <build>
        <defaultGoal>test-compile exec:java</defaultGoal>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <configuration>
              <mainClass>com.coam.pdfvalidator.tools.tsl.TslSync</mainClass>
              <classpathScope>test</classpathScope>
              <arguments>
                <argument>${project.basedir}/src/main/resources/truststore</argument>
              </arguments>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <!-- Mutation testing, deliberately outside the default build (slow):
           ./mvnw -Pmutation test-compile org.pitest:pitest-maven:mutationCoverage
           Report: target/pit-reports/index.html (and mutations.xml). -->
      <id>mutation</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-maven</artifactId>
            <version>${pitest.plugin.version}</version>
            <dependencies>
              <dependency>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-junit5-plugin</artifactId>
                <version>${pitest.junit5.version}</version>
              </dependency>
            </dependencies>
            <configuration>
              <targetClasses>
                <param>com.coam.pdfvalidator.*</param>
              </targetClasses>
              <targetTests>
                <param>com.coam.pdfvalidator.*</param>
              </targetTests>
              <outputFormats>
                <outputFormat>HTML</outputFormat>
                <outputFormat>XML</outputFormat>
              </outputFormats>
              <timestampedReports>false</timestampedReports>
              <threads>4</threads>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

</project>
