mvnw text eol=lf
*.cmd text eol=crlf
*.pdf binary
*.pptx binary

# Vendored third-party component (T11b): must stay byte-identical to the
# upstream file at all times (its NOTICE.md records the exact git blob SHA
# and size), so it must never be subject to line-ending normalization on
# any machine or platform.
src/main/resources/static/vendor/autofirma/* -text

# Docker build inputs must stay LF (they run on Linux).
Dockerfile text eol=lf
.dockerignore text eol=lf
docker-compose.yml text eol=lf

# Generated trust store (T14): byte-identical on every OS, so a re-run with unchanged
# trusted lists leaves no diff, locally or in the weekly CI job.
src/main/resources/truststore/** text eol=lf
